# Copy this file to .env and fill in your key.

# Required for the AI to respond at all.
# A free Gemini key (no credit card) from https://aistudio.google.com/apikey
# works out of the box. GEMINI_API_KEY is still accepted as the older name.
AI_API_KEY=paste-your-key-here

# Which AI service to talk to. Anything speaking the OpenAI "chat completions"
# format works: OpenAI, Liara AI, OpenRouter, a local Ollama, and Google (whose
# OpenAI-compatible endpoint is the default below).
#
# Change this if Google is not reachable from where you host. A server inside
# Iran cannot reach Google at all, and would point this at an Iranian
# provider's endpoint with MODEL_ID set to one of their models.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional overrides
# PORT=3000
# DB_PATH=./data/study-buddy.db
#
# The model name, as your provider spells it. Must match AI_BASE_URL.
#   Google: gemini-3.6-flash (default) or gemini-flash-latest
#           (the older gemini-2.5-* models are gone for new keys)
#   Others: whatever their dashboard lists
# MODEL_ID=gemini-3.6-flash
#
# Setting AI_API_KEY above already means every signed-in user spends it, so
# nobody needs a key of their own. That is the default and needs nothing here.
#
# Set this to 0 only for a public deployment where each user really is meant to
# bring their own key.
#
# While the site supplies the key, the per-user limits in src/services/usage.js
# are the only thing standing between one enthusiastic user and your bill.
# SHARED_API_KEY=0

# Optional: enables "Continue with Google" on the sign-in screen.
#
#   1. https://console.cloud.google.com/apis/credentials -> Create credentials
#      -> OAuth client ID -> Web application
#   2. Under "Authorized redirect URIs" add this app's callback, exactly:
#        https://your-domain/api/auth/google/callback
#      (locally: http://localhost:3000/api/auth/google/callback)
#      Google matches this string character for character. A trailing slash, or
#      http where the app serves https, is rejected as redirect_uri_mismatch.
#   3. Paste the client ID and secret below.
#
# Leave GOOGLE_REDIRECT_URI unset unless your host's proxy headers make the
# app guess the wrong scheme or hostname; then set it to the exact URI above.
# Without the first two, the button stays visible but disabled and says so.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Optional: sends every new account its welcome email with a discount code.
# Plain SMTP, so any mail service works - the app does not depend on a provider
# whose API might be unreachable from where it is hosted.
#
# Prove the settings before anyone signs up:
#   node scripts/send-test-email.js you@example.com fa
#
# SMTP_FROM should be an address at a domain this mailbox is allowed to send
# for. Sending as a domain you do not own is the usual reason a message is
# accepted and then filed as spam.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: the app's public base URL, e.g. https://buddy.example.com
#
# Needed once a custom domain is attached: the return from the payment gateway
# and the Google callback are both built from this. Without it the app reads
# the host from the request, which a proxy can report differently.
# APP_URL=

# Optional: enables real upgrades through ZarinPal.
# The merchant ID is the UUID from your ZarinPal panel. Prices live in
# src/services/usage.js and are charged in Rial; the request never decides them.
# ZARINPAL_MERCHANT_ID=

# Optional: gives every plan every track, whatever it paid for. For trying the
# app out - leave it unset to charge for the tracks as priced.
# UNLOCK_ALL_TRACKS=1

# Optional: the older Stripe path, kept for hosts where ZarinPal is not an
# option. Unnecessary if ZARINPAL_MERCHANT_ID is set.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
